{
  "name": "@fightclub/api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && node --watch dist/main.js",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/members/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "worker": "node dist/operations/worker.js",
    "test:integration": "node --import tsx scripts/source-schedule-check.ts && node --import tsx scripts/regression-check.ts && node --import tsx scripts/operations-check.ts"
  },
  "dependencies": {
    "@fightclub/shared": "2.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "pg": "^8.16.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "zod": "^4.1.12",
    "@aws-sdk/client-s3": "^3.900.0",
    "sharp": "^0.35.5",
    "multer": "^2.0.2",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "@types/pg": "^8.15.5",
    "@types/express": "^5.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/multer": "^2.0.0"
  }
}
