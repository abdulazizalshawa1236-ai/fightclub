# Copy this file to .env and edit.
PORT=3000
NODE_ENV=production

# First admin account (created only on the very first run)
ADMIN_USER=admin
ADMIN_PASS=

# Long random string for signing login cookies (optional, auto-generated if empty)
JWT_SECRET=

# Set to 1 when running behind nginx / a hosting proxy (needed for HTTPS cookies + rate limiting)
TRUST_PROXY=1

# Time zone used for "today" and subscription expiry
TZ_NAME=Asia/Riyadh

# WhatsApp Cloud API (leave empty until the club completes Meta Business setup)
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=fc_login_code
WHATSAPP_UTILITY_TEMPLATE=fc_member_update
WHATSAPP_MARKETING_TEMPLATE=fc_club_news
WHATSAPP_AR_LANGUAGE=ar
WHATSAPP_EN_LANGUAGE=en_US

# Where the database and uploaded images live (default ./data)
# DATA_DIR=/var/data
