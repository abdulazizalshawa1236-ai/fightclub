# Generate independent secrets. Never commit a populated .env.
NODE_ENV=development
PORT=4100
APP_ORIGIN=http://127.0.0.1:3100
API_ORIGIN=http://127.0.0.1:4100
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql://fightclub:replace-with-random-password@127.0.0.1:56432/fightclub
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
IDENTITY_DIGEST_KEY=replace-with-independent-64-hex-characters
ADMIN_USERNAME=club-admin
ADMIN_PASSWORD=replace-with-strong-password
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=fightclub-media
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret-key
MEDIA_PUBLIC_URL=http://127.0.0.1:3100/api/media
# Official Meta WhatsApp Business Platform only. Blank disables sending.
META_GRAPH_VERSION=v23.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_AUTH_TEMPLATE=
META_EXPIRING_TEMPLATE=
META_EXPIRED_TEMPLATE=
META_RENEWED_TEMPLATE=
META_MARKETING_TEMPLATE=
# Local preview alternative, production must use s3:
MEDIA_STORAGE=local
MEDIA_DIRECTORY=.runtime/media
